# Database. Local default is SQLite. For Neon/Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./fwf.db

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# First admin (seeded on startup if no users exist)
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin123

# CORS (comma-separated origins for the frontend). No trailing slash!
# Example for production: https://your-site.netlify.app
CORS_ORIGINS=http://localhost:3000
# Optional regex to allow dynamic origins like Netlify preview deploys:
# CORS_ORIGIN_REGEX=https://.*\.netlify\.app
